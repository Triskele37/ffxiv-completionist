{
    "compileOnSave": false,
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "outDir": "./dist/out-tsc",
        "module": "es2022",
        "sourceMap": true,
        "declaration": false,
        "moduleResolution": "bundler",
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "allowJs": true,
        "target": "ES2022",
        "types": [
            "node"
        ],
        "typeRoots": [
            "node_modules/@types"
        ],
        "lib": [
            "es2022",
            "dom"
        ],
        "paths": {
            "@admin/*": ["./src/app/admin/*"],
            "@constant": ["./src/app/constant"],
            "@constant/*": ["./src/app/constant/*"],
            "@component/*": ["./src/app/core/component/*"],
            "@data": ["./src/app/data"],
            "@data/*": ["./src/app/data/*"],
            "@decorator/*": ["./src/app/core/decorator/*"],
            "@directive/*": ["./src/app/core/directive/*"],
            "@model/*": ["./src/app/model/*"],
            "@pipe/*": ["./src/app/core/pipe/*"],
            "@service/*": ["./src/app/core/service/*"],
            "@test/*": ["./src/test/*"],
            "@util/*": ["./src/app/core/util/*"],
            "@view/*": ["./src/app/view/*"]
        }
    },
    "include": [
        "src/**/*.ts",
        "src/**/*.d.ts"
    ],
    "exclude": [
        "src/**/*.spec.ts",
        "src/**/*.mock.ts",
        "node_modules"
    ]
}
