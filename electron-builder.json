{
    "asar": false,
    "productName": "ffxiv-completionist",
    "appId": "com.ffxiv.completionist",
    "directories": {
        "output": "release/"
    },
    "files": [
        "**/*",
        "!**/*.ts",
        "!*.map",
        "!package.json",
        "!package-lock.json"
    ],
    "extraResources": [
        "./resources/**",
        {
            "from": "dist",
            "to": "app",
            "filter": [
                "**/*"
            ]
        }
    ],
    "win": {
        "icon": "assets/icons/icon.png",
        "target": [
            "portable"
        ]
    },
    "portable": {
        "splashImage": "dist/assets/icons/favicon.png"
    },
    "mac": {
        "icon": "assets/icons/icon.icns",
        "target": [
            "dmg"
        ]
    },
    "dmg": {
        "contents": [
            {
                "x": 410,
                "y": 150,
                "type": "link",
                "path": "/Applications"
            },
            {
                "x": 130,
                "y": 150,
                "type": "file"
            }
        ]
    },
    "linux": {
        "icon": "assets/icons",
        "target": [
            "AppImage"
        ]
    }
}

