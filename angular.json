{
    "$schema": "node_modules/@angular/cli/lib/config/schema.json",
    "cli": {
        "schematicCollections": [],
        "analytics": false
    },
    "version": 1,
    "projects": {
        "ffxiv-completionist": {
            "root": "desktop",
            "sourceRoot": "desktop/renderer",
            "projectType": "application",
            "architect": {
                "build": {
                    "builder": "@angular-builders/custom-webpack:browser",
                    "options": {
                        "outputPath": "desktop/dist",
                        "index": "desktop/renderer/index.html",
                        "main": "desktop/renderer/main.ts",
                        "tsConfig": "desktop/renderer/tsconfig.app.json",
                        "polyfills": "desktop/renderer/polyfills.ts",
                        "inlineStyleLanguage": "scss",
                        "assets": [
                            "desktop/renderer/assets"
                        ],
                        "styles": [
                            "desktop/renderer/styles.scss",
                            "node_modules/primeicons/primeicons.css"
                        ],
                        "stylePreprocessorOptions": {
                            "includePaths": [
                                "desktop/renderer/styles"
                            ]
                        },
                        "scripts": [],
                        "customWebpackConfig": {
                            "path": "./angular.webpack.js",
                            "replaceDuplicatePlugins": true
                        }
                    },
                    "configurations": {
                        "dev": {
                            "optimization": false,
                            "outputHashing": "none",
                            "sourceMap": true,
                            "namedChunks": false,
                            "aot": false,
                            "extractLicenses": true,
                            "vendorChunk": false,
                            "buildOptimizer": false,
                            "fileReplacements": [
                                {
                                    "replace": "desktop/renderer/env/env.ts",
                                    "with": "desktop/renderer/env/env.dev.ts"
                                }
                            ]
                        },
                        "production": {
                            "optimization": false,
                            "outputHashing": "all",
                            "sourceMap": false,
                            "namedChunks": false,
                            "aot": true,
                            "extractLicenses": true,
                            "vendorChunk": false,
                            "buildOptimizer": true,
                            "fileReplacements": [
                                {
                                    "replace": "desktop/renderer/env/env.ts",
                                    "with": "desktop/renderer/env/env.prod.ts"
                                }
                            ]
                        },
                        "web": {
                            "optimization": false,
                            "outputHashing": "none",
                            "sourceMap": true,
                            "namedChunks": false,
                            "aot": false,
                            "extractLicenses": true,
                            "vendorChunk": false,
                            "buildOptimizer": false,
                            "fileReplacements": [
                                {
                                    "replace": "desktop/renderer/env/env.ts",
                                    "with": "desktop/renderer/env/env.web.ts"
                                }
                            ]
                        },
                        "web-production": {
                            "optimization": true,
                            "outputHashing": "all",
                            "sourceMap": false,
                            "namedChunks": false,
                            "aot": true,
                            "extractLicenses": true,
                            "vendorChunk": false,
                            "buildOptimizer": true,
                            "fileReplacements": [
                                {
                                    "replace": "desktop/renderer/env/env.ts",
                                    "with": "desktop/renderer/env/env.web.prod.ts"
                                }
                            ]
                        }
                    }
                },
                "serve": {
                    "builder": "@angular-builders/custom-webpack:dev-server",
                    "options": {
                        "buildTarget": "ffxiv-completionist:build"
                    },
                    "configurations": {
                        "dev": {
                            "buildTarget": "ffxiv-completionist:build:dev"
                        },
                        "production": {
                            "buildTarget": "ffxiv-completionist:build:production"
                        },
                        "web": {
                            "buildTarget": "ffxiv-completionist:build:web"
                        },
                        "web-production": {
                            "buildTarget": "ffxiv-completionist:build:web-production"
                        }
                    }
                },
                "extract-i18n": {
                    "builder": "@angular-devkit/build-angular:extract-i18n",
                    "options": {
                        "buildTarget": "ffxiv-completionist:build"
                    }
                }
            }
        },
        "translate": {
            "root": "translate",
            "sourceRoot": "translate/renderer",
            "projectType": "application",
            "architect": {
                "build": {
                    "builder": "@angular-builders/custom-webpack:browser",
                    "options": {
                        "outputPath": "translate/dist",
                        "index": "translate/renderer/index.html",
                        "main": "translate/renderer/main.ts",
                        "tsConfig": "translate/renderer/tsconfig.app.json",
                        "polyfills": "translate/renderer/polyfills.ts",
                        "inlineStyleLanguage": "scss",
                        "assets": [
                            "translate/renderer/assets"
                        ],
                        "styles": [
                            "translate/renderer/styles.scss"
                        ],
                        "stylePreprocessorOptions": {
                            "includePaths": [
                                "translate/renderer/styles"
                            ]
                        },
                        "scripts": [],
                        "customWebpackConfig": {
                            "path": "./angular.webpack.js",
                            "replaceDuplicatePlugins": true
                        }
                    },
                    "configurations": {
                        "dev": {
                            "optimization": false,
                            "outputHashing": "none",
                            "sourceMap": true,
                            "namedChunks": false,
                            "aot": false,
                            "extractLicenses": true,
                            "vendorChunk": false,
                            "buildOptimizer": false,
                            "fileReplacements": [
                                {
                                    "replace": "translate/renderer/env/env.ts",
                                    "with": "translate/renderer/env/env.dev.ts"
                                }
                            ]
                        },
                        "web": {
                            "optimization": false,
                            "outputHashing": "none",
                            "sourceMap": true,
                            "namedChunks": false,
                            "aot": false,
                            "extractLicenses": true,
                            "vendorChunk": false,
                            "buildOptimizer": false,
                            "fileReplacements": [
                                {
                                    "replace": "translate/renderer/env/env.ts",
                                    "with": "translate/renderer/env/env.web.ts"
                                }
                            ]
                        }
                    }
                },
                "serve": {
                    "builder": "@angular-builders/custom-webpack:dev-server",
                    "options": {
                        "buildTarget": "translate:build"
                    },
                    "configurations": {
                        "dev": {
                            "buildTarget": "translate:build:dev"
                        },
                        "web": {
                            "buildTarget": "translate:build:web"
                        }
                    }
                },
                "extract-i18n": {
                    "builder": "@angular-devkit/build-angular:extract-i18n",
                    "options": {
                        "buildTarget": "translate:build"
                    }
                }
            }
        }
    }
}
