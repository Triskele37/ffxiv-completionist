{
    "ts-node": {
        "require": ["tsconfig-paths/register"]
    },
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "target": "es5",
        "module": "es2020",
        "baseUrl": ".",
        "outDir": "./dist",
        "sourceMap": true,
        "allowJs": true,
        "esModuleInterop": true,
        "moduleResolution": "node",
        "strict": false
    },
    "include": ["/**/*.ts"],
    "exclude": ["node_modules"]
}
