{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "outDir": "../out-tsc/spec",
        "module": "commonjs",
        "target": "ES2022",
        "types": [
            "jest",
            "node"
        ]
    },
    "include": [
        "**/*.spec.ts",
        "**/*.mock.ts",
        "**/*.d.ts"
    ],
    "exclude": [
        "dist",
        "release",
        "node_modules"
    ]
}
