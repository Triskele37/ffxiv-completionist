{
    "name": "ffxiv-completionist",
    "version": "1.0.4",
    "description": "Track your progress to 100% completion of Final Fantasy XIV.",
    "license": "GPL-3.0-only",
    "author": "Nicholas Simmons",
    "private": true,
    "main": "app/main.js",
    "scripts": {
        "build": "npm run electron:serve-tsc && ng build --base-href ./",
        "build:dev": "npm run build -- -c dev",
        "build:prod": "npm run build -- -c production",
        "electron": "electron",
        "electron:build": "npm run build:prod && electron-builder build --publish=never",
        "electron:build-linux": "npm run build:prod && electron-builder build --linux --publish=never",
        "electron:build-mac": "npm run build:prod && electron-builder build --mac --publish=never",
        "electron:local": "npm run build:prod && electron .",
        "electron:serve": "wait-on tcp:4200 && npm run electron:serve-tsc && electron . --serve",
        "electron:serve-tsc": "tsc -p tsconfig.serve.json",
        "lint": "ng lint",
        "ng": "ng",
        "ng:serve": "ng serve -c web -o",
        "postinstall": "electron-builder install-app-deps",
        "start": "npm-run-all -p electron:serve ng:serve",
        "serve": "npm run electron:serve-tsc && electron . --serve"
    },
    "browserslist": [
        "chrome 91"
    ],
    "dependencies": {
        "@angular/animations": "17.3.6",
        "@angular/common": "17.3.6",
        "@angular/compiler": "17.3.6",
        "@angular/core": "17.3.6",
        "@angular/forms": "17.3.6",
        "@angular/language-service": "17.3.6",
        "@angular/platform-browser": "17.3.6",
        "@angular/platform-browser-dynamic": "17.3.6",
        "@angular/router": "17.3.6",
        "material-icons": "1.13.12",
        "primeicons": "^7.0.0",
        "primeng": "17.16.0",
        "rxjs": "7.8.1",
        "tslib": "2.6.2",
        "zone.js": "0.14.4"
    },
    "devDependencies": {
        "@angular-builders/custom-webpack": "17.0.2",
        "@angular-devkit/build-angular": "17.3.6",
        "@angular-eslint/builder": "17.3.0",
        "@angular-eslint/eslint-plugin": "17.3.0",
        "@angular-eslint/eslint-plugin-template": "17.3.0",
        "@angular-eslint/schematics": "17.3.0",
        "@angular-eslint/template-parser": "17.3.0",
        "@angular/cdk": "17.3.6",
        "@angular/cli": "17.3.6",
        "@angular/compiler-cli": "17.3.6",
        "@ngx-translate/core": "15.0.0",
        "@ngx-translate/http-loader": "8.0.0",
        "@types/node": "20.12.7",
        "@typescript-eslint/eslint-plugin": "7.7.1",
        "@typescript-eslint/parser": "7.7.1",
        "electron": "30.0.1",
        "electron-builder": "24.13.3",
        "electron-debug": "3.2.0",
        "electron-reload": "1.2.3",
        "eslint": "8.57.0",
        "node-polyfill-webpack-plugin": "2.0.1",
        "npm-run-all": "4.1.5",
        "ts-node": "10.9.2",
        "typescript": "5.4.5",
        "wait-on": "7.2.0"
    }
}
