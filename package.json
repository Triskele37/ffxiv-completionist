{
    "name": "ffxiv-completionist",
    "version": "1.0.6",
    "description": "Track your progress to 100% completion of Final Fantasy XIV.",
    "author": "Nicholas Simmons",
    "private": true,
    "type": "module",
    "workspaces": [
        "desktop",
        "translate"
    ],
    "scripts": {
        "postinstall": "electron-builder install-app-deps",
        "start": "npm run start -w desktop",
        "asar:extract": "npx @electron/asar extract",
        "script:i18nHelper": "node ./scripts/i18nHelper/npmi18nHelper.js"
    },
    "browserslist": [
        "chrome 91"
    ],
    "dependencies": {
        "@angular/animations": "22.1.0",
        "@angular/common": "22.1.0",
        "@angular/compiler": "22.1.0",
        "@angular/core": "22.1.0",
        "@angular/forms": "22.1.0",
        "@angular/language-service": "22.1.0",
        "@angular/platform-browser": "22.1.0",
        "@angular/router": "22.1.0",
        "@primeuix/themes": "^3.0.0",
        "material-icons": "1.13.14",
        "primeicons": "8.0.0",
        "primeng": "22.0.0",
        "rxjs": "7.8.2",
        "tslib": "2.8.1",
        "zone.js": "0.16.2"
    },
    "devDependencies": {
        "@angular-builders/custom-webpack": "22.0.1",
        "@angular-eslint/builder": "^22.1.0",
        "@angular/build": "22.1.0",
        "@angular/cdk": "22.1.0",
        "@angular/cli": "22.1.0",
        "@angular/compiler-cli": "22.1.0",
        "@ngx-translate/core": "18.0.0",
        "@ngx-translate/http-loader": "18.0.0",
        "@types/jest": "^30.0.0",
        "@types/node": "26.1.2",
        "angular-eslint": "^22.1.0",
        "electron": "43.2.0",
        "electron-builder": "26.15.3",
        "electron-debug": "4.1.0",
        "electron-reload": "1.5.0",
        "eslint": "10.8.0",
        "jest": "^30.4.2",
        "jest-environment-jsdom": "^30.4.1",
        "jest-preset-angular": "^17.0.0",
        "node-polyfill-webpack-plugin": "4.1.0",
        "npm-run-all": "4.1.5",
        "ts-node": "10.9.2",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.67.0",
        "wait-on": "9.1.0"
    }
}
